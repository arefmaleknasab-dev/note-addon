{
  "manifest_version": 3,
  "name": "بوم یادداشت — دفترچه‌ی یادداشت فارسی",
  "short_name": "بوم یادداشت",
  "version": "1.0.0",
  "description": "یادداشت‌برداری فارسی روی یک بوم نامحدود؛ با راست‌کلیک متن هر صفحه را به یادداشت‌ها بفرست. ذخیره‌سازی دائمی، حالت تاریک/روشن، زوم و انتخاب گروهی.",
  "permissions": [
    "storage",
    "contextMenus",
    "notifications",
    "clipboardWrite",
    "clipboardRead",
    "scripting",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "باز کردن بوم یادداشت",
    "default_icon": {
      "16": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon128.png",
    "32": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  }
}
